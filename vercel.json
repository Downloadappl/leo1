{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 300
    }
  },
  "routes": [
    {
      "src": "/\\.well-known/assetlinks\\.json",
      "dest": "/frontend/.well-known/assetlinks.json"
    },
    {
      "src": "/mobile-oauth-return",
      "dest": "/frontend/mobile-oauth-return.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
